# 前端静态文件由 CI 在工作区生成到 `frontend/dist`，Dockerfile 直接复制
# 使用进迭时空镜像
FROM harbor.spacemit.com/bianbu/bianbu:latest

# 避免交互式安装
ENV DEBIAN_FRONTEND=noninteractive

# NGINX安装
RUN apt-get update && apt-get install -y nginx curl bash

# Nodejs安装
RUN apt-get install -y nodejs npm

#python311安装
RUN apt update && \
        apt install software-properties-common -y
RUN add-apt-repository ppa:deadsnakes/ppa

RUN apt update --fix-missing && \
        apt install python3.11 python3.11-distutils python3.11-dev python3.11-venv -y && \
        apt install python3-pip -y && \
        ln -sf /usr/bin/python3.11 /usr/bin/python && \
        ln -sf /usr/bin/pip3 /usr/bin/pip

# 设置Python环境变量
ENV PYTHONUNBUFFERED=1

# 安装系统库依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    libopenblas-dev \
    libjpeg-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# 创建Python虚拟环境
RUN python3.11 -m venv /opt/venv

# 激活虚拟环境并升级pip
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --upgrade pip

# 安装PyTorch CPU版本
RUN pip3 install --no-cache-dir \
    torch \
    torchvision \
    torchaudio \
    --index-url https://download.pytorch.org/whl/cpu --break-system-packages

# 安装macls及其依赖
RUN pip3 install --no-cache-dir \
    numba \
    llvmlite \
    macls --break-system-packages

# 设置工作目录
WORKDIR /app

# 复制后端依赖文件
COPY backend/package*.json ./backend/
COPY package*.json ./

# 安装后端依赖
RUN cd backend && npm install --only=production

# 复制后端源代码
COPY backend/. ./backend/

# 复制 CI 生成的前端静态文件到 Nginx 目录
COPY frontend/dist /var/www/html

# 复制Nginx配置
COPY nginx.conf /etc/nginx/nginx.conf

# 复制启动脚本
COPY start.sh /app/start.sh
RUN chmod +x /app/start.sh

# 创建必要的目录和设置权限
RUN mkdir -p \
    /app/backend/uploads \
    /var/log/nginx \
    /var/lib/nginx/body \
    /var/run/nginx

RUN if ! getent group 1000 >/dev/null 2>&1; then groupadd -g 1000 appgroup; fi && \
    if ! id -u 1000 >/dev/null 2>&1; then useradd -m -u 1000 -g 1000 appuser; fi
RUN chown -R 1000:1000 /app
RUN chmod -R 777 backend/uploads
RUN chown -R 1000:1000 /var/log/nginx \
    && chown -R 1000:1000 /var/lib/nginx \
    && chown -R 1000:1000 /var/run/nginx \
    && chown -R 1000:1000 /var/www/html \
    && chown -R 1000:1000 /etc/nginx

# 添加构建参数（由 CI 传入）
ARG BUILD_TIME=""
ARG VERSION=""
ARG GIT_COMMIT=""

# 将构建参数导出为环境变量（便于在镜像运行时可见）
ENV BUILD_TIME=${BUILD_TIME}
ENV VERSION=${VERSION}
ENV GIT_COMMIT=${GIT_COMMIT}

# 生成并写入后端环境文件（包含构建信息与随机密钥）
RUN mkdir -p ./backend && \
    echo "BUILD_TIME=${BUILD_TIME}" > ./backend/.env && \
    echo "VERSION=${VERSION}" >> ./backend/.env && \
    echo "GIT_COMMIT=${GIT_COMMIT}" >> ./backend/.env && \
    echo "REFRESH_TOKEN_SECRET=$(openssl rand -hex 32)" >> ./backend/.env && \
    echo "ACCESS_TOKEN_SECRET=$(openssl rand -hex 32)" >> ./backend/.env && \
    chown 1000:1000 ./backend/.env && \
    chmod 640 ./backend/.env

# 以 root 身份运行 entrypoint，它会修正权限后切换到 appuser
USER appuser

# 暴露端口 (Nginx端口)
EXPOSE 80

# 启动应用 (同时运行Nginx和后端)
WORKDIR /app
CMD ["/app/start.sh"]