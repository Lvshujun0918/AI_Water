# 前端静态文件由 CI 在工作区生成到 `frontend/dist`，Dockerfile 直接复制
# 使用进迭时空镜像
FROM ubuntu:24.04

# 避免交互式安装
ENV DEBIAN_FRONTEND=noninteractive

# NGINX安装
RUN apt-get update && apt-get install -y nginx curl bash wget

# Nodejs安装
RUN apt-get install -y nodejs npm

# pyenv安装
RUN apt-get update && apt-get install python3-virtualenv -y

# pip3安装
RUN apt-get update && apt-get install -y python3-pip

# 设置Python环境变量
ENV PYTHONUNBUFFERED=1

# 安装系统库依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    libopenblas-dev \
    libjpeg-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y \
    ca-certificates \
    openssl \
    python3-openssl \
 && update-ca-certificates

# 创建Python虚拟环境
RUN virtualenv aiwater

# 激活虚拟环境并升级pip
RUN . aiwater/bin/activate

# 设置工作目录
WORKDIR /app

COPY whl/ ./whl/

# pip手动安装
RUN pip install --upgrade setuptools --break-system-packages

RUN pip config set global.extra-index-url https://git.spacemit.com/api/v4/projects/33/packages/pypi/simple

RUN pip install --trusted-host git.spacemit.com torch==2.8.0 --break-system-packages

RUN pip install --trusted-host git.spacemit.com torchvision==0.23.0 --break-system-packages

RUN pip install --trusted-host git.spacemit.com torchaudio==2.8.0 --break-system-packages

RUN pip install --trusted-host git.spacemit.com numba==0.62.1 --break-system-packages

RUN pip install --trusted-host git.spacemit.com llvmlite==0.45.1 --break-system-packages

RUN cd ./whl/AudioClassification-Pytorch/
RUN ls -lh
RUN pip install . --break-system-packages

# 复制后端依赖文件
COPY backend/package*.json ./backend/
COPY package*.json ./

# 安装后端依赖
RUN cd backend && npm install --only=production

# 复制后端源代码
COPY backend/. ./backend/

# 复制 CI 生成的前端静态文件到 Nginx 目录
COPY frontend/dist /var/www/html

# 复制Nginx配置
COPY nginx.conf /etc/nginx/nginx.conf

# 复制启动脚本
COPY start.sh /app/start.sh
RUN chmod +x /app/start.sh

# 创建必要的目录和设置权限
RUN mkdir -p \
    /app/backend/uploads \
    /var/log/nginx \
    /var/lib/nginx/body \
    /var/run/nginx

RUN if ! getent group 1000 >/dev/null 2>&1; then groupadd -g 1000 appgroup; fi && \
    if ! id -u 1000 >/dev/null 2>&1; then useradd -m -u 1000 -g 1000 appuser; fi
RUN chown -R 1000:1000 /app
RUN chmod -R 777 backend/uploads
RUN chown -R 1000:1000 /var/log/nginx \
    && chown -R 1000:1000 /var/lib/nginx \
    && chown -R 1000:1000 /var/run/nginx \
    && chown -R 1000:1000 /var/www/html \
    && chown -R 1000:1000 /etc/nginx

# 添加构建参数（由 CI 传入）
ARG BUILD_TIME=""
ARG VERSION=""
ARG GIT_COMMIT=""

# 将构建参数导出为环境变量（便于在镜像运行时可见）
ENV BUILD_TIME=${BUILD_TIME}
ENV VERSION=${VERSION}
ENV GIT_COMMIT=${GIT_COMMIT}

# 生成并写入后端环境文件（包含构建信息与随机密钥）
RUN mkdir -p ./backend && \
    echo "BUILD_TIME=${BUILD_TIME}" > ./backend/.env && \
    echo "VERSION=${VERSION}" >> ./backend/.env && \
    echo "GIT_COMMIT=${GIT_COMMIT}" >> ./backend/.env && \
    echo "REFRESH_TOKEN_SECRET=$(openssl rand -hex 32)" >> ./backend/.env && \
    echo "ACCESS_TOKEN_SECRET=$(openssl rand -hex 32)" >> ./backend/.env && \
    chown 1000:1000 ./backend/.env && \
    chmod 640 ./backend/.env

# 以 root 身份运行 entrypoint，它会修正权限后切换到 appuser
USER appuser

# 暴露端口 (Nginx端口)
EXPOSE 80

# 启动应用 (同时运行Nginx和后端)
WORKDIR /app
CMD ["/app/start.sh"]